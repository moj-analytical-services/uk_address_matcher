{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.1.0.json",
  "description": "Recall-aligned false-positive reduction chart",
  "width": 620,
  "height": 180,
  "data": {
    "values": []
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#A0A5B4",
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "y": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "point": {
          "filled": true,
          "size": 34
        }
      },
      "encoding": {
        "x": {
          "field": "baseline_recall",
          "type": "quantitative",
          "title": "Baseline recall",
          "axis": {
            "format": ".1%"
          },
          "scale": {
            "domain": [
              0,
              1
            ]
          }
        },
        "y": {
          "field": "false_positive_reduction_percent",
          "type": "quantitative",
          "title": "Reduction in false positives (%)",
          "axis": {
            "format": "+.1f"
          }
        },
        "order": {
          "field": "baseline_recall",
          "type": "quantitative"
        },
        "color": {
          "field": "comparison_label",
          "type": "nominal",
          "title": "Comparison",
          "scale": {
            "range": [
              "#28A197",
              "#F46A25",
              "#801650",
              "#1D609D",
              "#30AA51",
              "#A285D1",
              "#00B1EB"
            ]
          }
        },
        "tooltip": [
          {
            "field": "comparison_label",
            "type": "nominal",
            "title": "Comparison"
          },
          {
            "field": "baseline_recall",
            "type": "quantitative",
            "title": "Baseline recall",
            "format": ".2%"
          },
          {
            "field": "baseline_fp",
            "type": "quantitative",
            "title": "False positives before",
            "format": ".0f"
          },
          {
            "field": "comparison_fp",
            "type": "quantitative",
            "title": "False positives after",
            "format": ".1f"
          },
          {
            "field": "false_positive_reduction",
            "type": "quantitative",
            "title": "False positives reduced",
            "format": "+.1f"
          },
          {
            "field": "false_positive_reduction_percent",
            "type": "quantitative",
            "title": "False positive reduction (%)",
            "format": "+.1f"
          }
        ]
      }
    }
  ]
}